<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Two keys that cannot be expressed as INFOPLIST_KEY_* build settings.

	  UIBackgroundModes/audio is what lets a recording keep running when the
	  screen locks or the user switches apps. Without it iOS suspends the app and
	  the recording ends there — the single largest cap on how long a capture
	  could be. Recording is the only thing this app does in the background; it
	  plays no audio and starts nothing on its own.

	  UIFileSharingEnabled exposes the app's Documents folder in Files, which is
	  how on-device captures stay reachable. It was previously set as
	  INFOPLIST_KEY_UIFileSharingEnabled in project.yml, which Xcode 26 does not
	  map — the key never reached the built Info.plist and the feature was
	  silently off. Verify with `plutil -p` on the built .app after changing this.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!--
	  Required before LocalAuthentication may present Face ID. Without it the
	  evaluatePolicy call fails outright rather than prompting, exactly the way a
	  missing NSMicrophoneUsageDescription silently defeats the recorder.
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>Unli Rice uses Face ID to keep your voice notes private when someone else picks up your phone.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
